<Window x:Class="Skein.ShortcutsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Keyboard shortcuts" Width="620" Height="720" MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource ButtonBar}">
            <DockPanel>
                <Button x:Name="ResetAll" Content="Reset all to standard" Click="OnResetAll" />
                <Button DockPanel.Dock="Right" Content="Close" MinWidth="96" HorizontalAlignment="Right" IsCancel="True" IsDefault="True"
                        Style="{DynamicResource AccentButtonStyle}" />
            </DockPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20,24,12">
            <StackPanel>
                <TextBlock Text="Keyboard shortcuts" Style="{StaticResource DialogTitle}" />
                <TextBlock Style="{StaticResource PageIntro}"
                           Text="Click a key to change it, then press the new one (Esc to cancel). If another shortcut used that key, the two swap." />
                <TextBlock x:Name="Message" Style="{StaticResource Status}" Margin="0,0,0,8" Visibility="Collapsed" />
                <StackPanel x:Name="List" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
