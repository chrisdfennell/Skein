<Window x:Class="Skein.AlertsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alerts" Width="880" Height="720" MinWidth="660" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource ButtonBar}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Save" MinWidth="96" IsDefault="True" Click="OnSave" Style="{DynamicResource AccentButtonStyle}" />
                    <Button Content="Cancel" MinWidth="96" Margin="8,0,0,0" IsCancel="True" />
                </StackPanel>
                <TextBlock x:Name="Error" Foreground="#E5484D" TextWrapping="Wrap" VerticalAlignment="Center" Visibility="Collapsed" />
            </DockPanel>
        </Border>

        <Grid Margin="24,20,24,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="170" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="🔔 Alerts" Style="{StaticResource DialogTitle}" />
                <TextBlock Style="{StaticResource PageIntro}"
                           Text="Skein checks Reddit in the background (in the tray too) and tells you about new posts that match." />
            </StackPanel>

            <!-- Keyword alerts -->
            <Border Grid.Row="1" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Keyword alerts" Style="{StaticResource Title}" />
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Help}" Margin="0,2,0,10">
                        Titles containing any of the words count. Separate words or phrases with commas; a minus excludes one
                        (<Run FontFamily="Consolas" Text="RTX, 4090, -broken" />). Leave Communities empty to search all of Reddit,
                        or list them (<Run FontFamily="Consolas" Text="hardwareswap, buildapcsales" />). With no words, every new post there counts.
                    </TextBlock>
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock Text="Check every" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="Interval" MinWidth="120" AutomationProperties.Name="Check every">
                                <ComboBoxItem Content="2 minutes" Tag="2" />
                                <ComboBoxItem Content="5 minutes" Tag="5" />
                                <ComboBoxItem Content="15 minutes" Tag="15" />
                                <ComboBoxItem Content="30 minutes" Tag="30" />
                                <ComboBoxItem Content="hour" Tag="60" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="+ Add alert" Click="OnAdd" />
                            <Button Content="Remove" Margin="8,0,0,0" Click="OnRemove" />
                        </StackPanel>
                    </DockPanel>
                    <DataGrid x:Name="Rules" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" SelectionMode="Single" AutomationProperties.Name="Keyword alerts">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="50" />
                            <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="140" />
                            <DataGridTextColumn Header="Words" Binding="{Binding Keywords, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
                            <DataGridTextColumn Header="Communities (empty = all)" Binding="{Binding Subreddits, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
                            <DataGridCheckBoxColumn Header="Post text too" Binding="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <TextBlock Grid.Row="2" Text="Threads and people" Style="{StaticResource Group}" />

            <!-- Threads you watch and people you follow (added from the post view or a right-click). -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" x:Name="WatchedHeading" Style="{StaticResource Title}" />
                        <TextBlock DockPanel.Dock="Top" Text="Told when new comments arrive. Use 🔔 Watch on a post." Style="{StaticResource Help}" Margin="0,2,0,6" />
                        <ListBox x:Name="Watched" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0"
                                 AutomationProperties.Name="Threads you watch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Stop" Padding="8,1" Click="OnStopWatching" Tag="{Binding}" />
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                   ToolTip="{Binding Title}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" x:Name="FollowedHeading" Style="{StaticResource Title}" />
                        <TextBlock DockPanel.Dock="Top" Text="Told when they post. Use Follow from the ⋯ next to their name." Style="{StaticResource Help}" Margin="0,2,0,6" />
                        <ListBox x:Name="Followed" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0"
                                 AutomationProperties.Name="People you follow">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Unfollow" Padding="8,1" Click="OnUnfollow" Tag="{Binding}" />
                                        <TextBlock Text="{Binding Name, StringFormat=u/{0}}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
