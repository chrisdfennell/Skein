<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The look shared by Skein's dialogs: settings on softly shaded cards, a title and a
         plain description for each, and section headings. -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="#10808080" />
        <Setter Property="BorderBrush" Value="#18808080" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style x:Key="Title" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Help" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Opacity" Value="0.7" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
    <!-- Help text under a checkbox lines up with the checkbox's label. -->
    <Style x:Key="CheckHelp" TargetType="TextBlock" BasedOn="{StaticResource Help}">
        <Setter Property="Margin" Value="28,2,0,0" />
    </Style>
    <Style x:Key="Group" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="2,18,0,8" />
    </Style>
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="DialogTitle" TargetType="TextBlock" BasedOn="{StaticResource PageTitle}">
        <Setter Property="FontSize" Value="22" />
    </Style>
    <Style x:Key="PageIntro" TargetType="TextBlock">
        <Setter Property="Opacity" Value="0.7" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style x:Key="Status" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Opacity" Value="0.8" />
        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>
    <!-- The bar along the bottom of a dialog, holding its main buttons. -->
    <Style x:Key="ButtonBar" TargetType="Border">
        <Setter Property="BorderBrush" Value="#20808080" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="24,12" />
    </Style>
    <!-- A key on the keyboard, as shown in the shortcut list and welcome tour. -->
    <Style x:Key="KeyCap" TargetType="Border">
        <Setter Property="BorderBrush" Value="#50808080" />
        <Setter Property="BorderThickness" Value="1,1,1,2" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Background" Value="#14808080" />
    </Style>
</ResourceDictionary>
